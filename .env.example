# Copie para .env (local) ou cadastre como variáveis no Railway.

# Postgres. No Railway isso é preenchido sozinho ao adicionar o banco —
# use a referência ${{Postgres.DATABASE_URL}} em vez de colar a senha.
DATABASE_URL=postgresql://usuario:senha@host:5432/railway

# Senha do painel /admin e da exportação CSV. Gere um valor longo e aleatório.
ADMIN_TOKEN=troque-por-algo-longo-e-aleatorio

# Porta. No Railway é injetada automaticamente; não precisa cadastrar.
PORT=3000

# Web App do Apps Script que copia os pedidos para o Google Planilhas.
# Já vem preenchido em config.js; só cadastre aqui para trocar de planilha
# ou deixe em branco para desligar a cópia em tempo real.
# PLANILHA_URL=https://script.google.com/macros/s/SEU_ID/exec
